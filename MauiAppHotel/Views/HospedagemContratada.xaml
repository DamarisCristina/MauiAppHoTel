<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHoTel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Border
        Stroke="{StaticResource Primary}"
        StrokeThickness="4"
        StrokeShape="RoundRectangle 15"
        Padding="10"
        Margin="20">

        <VerticalStackLayout VerticalOptions="CenterAndExpand">

            <Label Text="Suíte Super Luxo"
                   TextColor="{StaticResource Primary}"
                   FontFamily="Kalam"
                   FontSize="50"
                   HorizontalTextAlignment="Center"/>

            <Label Text="Sua hospedagem foi contratada!"
       FontSize="16"
       TextColor="Gray"
       HorizontalTextAlignment="Center"/>

            <Label Text="Dados dos hóspedes:"
       FontSize="18"
       FontAttributes="Bold"
       TextColor="{StaticResource Primary}"/>
            
            <Frame Margin="10">
                <HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Adultos: "/>
                        <Label Text="2"
                               TextColor="{StaticResource Primary}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Crianças: "/>
                        <Label Text="1"
                               TextColor="{StaticResource Primary}"/>
                    </HorizontalStackLayout>

                </HorizontalStackLayout>
            </Frame>


            <Label Text="Período da hospedagem: "
       FontSize="18"
       FontAttributes="Bold"
       TextColor="{StaticResource Primary}"/>
            
            <Frame Margin="10">
                <Grid ColumnDefinitions="*, *, *"
                      RowDefinitions="Auto, Auto">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Check-in"/>
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="Check-out"/>
                    <Label Grid.Row="0" Grid.Column="2"
                           Text="Estadia"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="07/11/2026"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="30/11/2026"/>
                    <Label Grid.Row="1" Grid.Column="2"
                           Text="3"/>

                </Grid>
            </Frame>

            <Label Text="Resumo do pagamento:  "
       FontSize="18"
       FontAttributes="Bold"
       TextColor="{StaticResource Primary}"/>
            
            <Frame Margin="10">
                <HorizontalStackLayout>
                    <Label Text="Valor Total: "/>
                    <Label Text="R$ 750,00"/>
                </HorizontalStackLayout>
            </Frame>

            <Label Text="Agradecemos pela preferência! Desejamos uma ótima estadia. ❤️"
       FontSize="14"
       TextColor="Gray"
       HorizontalTextAlignment="Center"
       Margin="5,10"/>

            <Label Text="Dúvidas entre em contato com a nossa central de atendimento por WhatsApp pelo número: (16) 99436-7864"
FontSize="14"
TextColor="DarkGray"
HorizontalTextAlignment="Center"
Margin="5,10"/>

            <Button Text="Voltar"
                    HorizontalOptions="Center"
                    Clicked="Button_Clicked"/>

        </VerticalStackLayout>

    </Border>

</ContentPage>
