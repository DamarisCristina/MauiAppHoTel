<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHoTel.Views.ContratacaoDaHospedagem"
             Title="ContratacaoDaHospedagem"
             NavigationPage.HasNavigationBar="False" 
             BackgroundColor="{StaticResource Gray100}">

    <Border
    Stroke="{StaticResource Primary}"
    StrokeThickness="4"
    StrokeShape="RoundRectangle 15"
    Padding="10"
    Margin="20">

        <VerticalStackLayout VerticalOptions="Center"
                         Padding="10">

            <Label Text="Cálculo da Diária!"
       FontFamily="KalamRegular"
       FontSize="40"
       TextColor="{StaticResource Primary}"
       HorizontalTextAlignment="Center"/>

            <Label Text="Preencha os dados para sua hospedagem"
       FontSize="14"
       HorizontalTextAlignment="Center"
       TextColor="Gray"
       Margin="0,0,0,15"/>

            <Frame Padding="15">
            <VerticalStackLayout>
                
                    <Label Text="Quantidade de hóspedes"
       FontSize="18"
       FontAttributes="Bold"
       TextColor="{StaticResource Primary}"
       Margin="5,10"/>
                
                    <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Column="0"
                           Text="Adultos: "/>


                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                              x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                    <Label Grid.Column="0"
                           Grid.Row="1"
                            Text="Crianças: "/>

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                              x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>


                </Grid>


                <Label Text="Escolha sua Suíte" Padding="15"/>

                    <Label Text="Escolha a acomodação ideal para sua estadia:"
       FontSize="14"
       TextColor="Gray"
       Margin="0,10,0,5"/>

                    <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação"
                        ItemDisplayBinding="{Binding Descricao}"/>

                <Frame Padding="10"
                       Margin="15">

                    <VerticalStackLayout>
                        <Label Text="Período da Estadia"  />

                        <HorizontalStackLayout>
                            <Label Text="Check-in: "/>
                            <DatePicker x:Name="stock_checkin"
                                        DateSelected="stock_checkin_DateSelected"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out: "/>
                            <DatePicker x:Name="stock_checkout"
                                        DateSelected="stock_checkout_DateSelected"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Frame>

                    <Button Text="Avançar" Clicked="Avancar_Clicked"/>

                    <Button Text="Sobre" Margin="0,10,0,0"
                        Clicked="Sobre_Clicked"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>

    </Border>
</ContentPage>