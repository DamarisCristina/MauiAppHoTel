<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHoTel.Views.ContratacaoDaHospedagem"
             Title="ContratacaoDaHospedagem"
             NavigationPage.HasNavigationBar="False" 
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center" Padding="10" Spacing="10">

        <Label 
            Text="Cálculo da Diária!"
            FontFamily="KalamRegular"
            FontSize="50"
            TextColor="{StaticResource Primary}"/>

        <Border Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">


                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"

                    <Stepper Grid.Row="0" Grid.Column="2"
                              x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças: " 
                           VerticalOptions="Center"/>

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"

                    <Stepper Grid.Row="1" Grid.Column="2"
                              x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>


                </Grid>


                <Label Text="Escolha sua Suíte"/>

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação"/>

                <Frame Padding="10"
                       Margin="0">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Período da Estadia" FontAttributes="Bold" />
                        
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Check-in: " VerticalOptions="Center"/>
                            <DatePicker x:Name="stock_checkin"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Check-out: " VerticalOptions="Center"/>
                        <DatePicker x:Name="stock_checkout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    
                    </VerticalStackLayout>
                         
                </Frame>

                <Button Text="Avançar"/>

                <Button Text="Sobre" Margin="0,10,0,0"
                        Clicked="Button_Clicked"    />


            </VerticalStackLayout>
        </Border>
    
    </VerticalStackLayout>
</ContentPage>