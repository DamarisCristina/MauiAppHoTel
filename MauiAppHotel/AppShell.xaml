<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHoTel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppHoTel"
    xmlns:views="clr-namespace:MauiAppHoTel.Views"
    Title="MauiAppHoTel">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Sobre"
        ContentTemplate="{DataTemplate views:Sobre}"
        Route="Sobre" />
    
</Shell>
